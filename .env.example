# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=metrics
POSTGRES_PASSWORD=changeme
POSTGRES_DB=metrics

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme

# --- ntfy.sh (dead man's switch notifications) ---
# NTFY_URL defaults to https://ntfy.sh if using the public server;
# point it at your own instance if self-hosting.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=changeme

# How many extra minutes past a collector's expected_interval_minutes
# before it's considered overdue. Optional, defaults to 30.
DEAD_MANS_SWITCH_GRACE_MINUTES=30

# --- xbox-time collector ---
OPENXBL_API_KEY=changeme
XBOX_TIME_XUID=

# --- completed-tasks collector ---
TODOIST_API_TOKEN=changeme

# --- GHCR credentials for the ofelia container ---
# ofelia pulls private ghcr.io images itself (for job-run jobs) using its
# own container, which has no access to your host's docker login. Create a
# classic PAT with only the `read:packages` scope for this.
GHCR_USERNAME=changeme
GHCR_TOKEN=changeme
